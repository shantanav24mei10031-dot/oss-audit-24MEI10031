	position: fixed; /* Setting position fixed to this container instead of .nav-primary, fixes IE flicker issue */
}

.nav-primary.nav-primary-sticky {
	width: 100%;
	max-width: 100%;
	border-radius: 0;
	box-shadow: none;
}

.nav-primary-sticky-slidein {	
	top: -90px;
	display: block;
}

.nav-primary-sticky-slidein-transition {
